# Optional explicit API URL for mobile app requests
# Use this for physical devices on same Wi-Fi as backend machine.
# Example: http://192.168.1.6:3000/api/v1
EXPO_PUBLIC_API_BASE_URL=

# Alternative host-only option (used when EXPO_PUBLIC_API_BASE_URL is empty)
# Example: 192.168.1.6
EXPO_PUBLIC_DEV_MACHINE_IP=
